{
  "multipart": [
    {
      "when": {
        "up": "true",
        "down": "true",
        "north": "false",
        "south": "false",
        "east": "false",
        "west": "false"
      },
      "apply": { "model": "minecraft:block/maple_leaves" }
    },

    {
      "when": { "north": "true" },
      "apply": { "model": "minecraft:block/red_mushroom_block" }
    },
    {
      "when": { "east": "true" },
      "apply": { "model": "minecraft:block/red_mushroom_block", "y": 90, "uvlock": true }
    },
    {
      "when": { "south": "true" },
      "apply": { "model": "minecraft:block/red_mushroom_block", "y": 180, "uvlock": true }
    },
    {
      "when": { "west": "true" },
      "apply": { "model": "minecraft:block/red_mushroom_block", "y": 270, "uvlock": true }
    },
    {
      "when": {
        "OR": [
          { "up": "true", "down": "false" },
          { "up": "true", "north": "true" },
          { "up": "true", "south": "true" },
          { "up": "true", "east": "true" },
          { "up": "true", "west": "true" }
        ]
      },
      "apply": { "model": "minecraft:block/red_mushroom_block", "x": 270, "uvlock": true }
    },
    {
      "when": {
        "OR": [
          { "down": "true", "up": "false" },
          { "down": "true", "north": "true" },
          { "down": "true", "south": "true" },
          { "down": "true", "east": "true" },
          { "down": "true", "west": "true" }
        ]
      },
      "apply": { "model": "minecraft:block/red_mushroom_block", "x": 90, "uvlock": true }
    },

    {
      "when": {
        "OR": [
          { "north": "false", "up": "false" },
          { "north": "false", "down": "false" },
          { "north": "false", "south": "true" },
          { "north": "false", "east": "true" },
          { "north": "false", "west": "true" }
        ]
      },
      "apply": { "model": "minecraft:block/mushroom_block_inside" }
    },
    {
      "when": {
        "OR": [
          { "east": "false", "up": "false" },
          { "east": "false", "down": "false" },
          { "east": "false", "north": "true" },
          { "east": "false", "south": "true" },
          { "east": "false", "west": "true" }
        ]
      },
      "apply": { "model": "minecraft:block/mushroom_block_inside", "y": 90, "uvlock": false }
    },
    {
      "when": {
        "OR": [
          { "south": "false", "up": "false" },
          { "south": "false", "down": "false" },
          { "south": "false", "north": "true" },
          { "south": "false", "east": "true" },
          { "south": "false", "west": "true" }
        ]
      },
      "apply": { "model": "minecraft:block/mushroom_block_inside", "y": 180, "uvlock": false }
    },
    {
      "when": {
        "OR": [
          { "west": "false", "up": "false" },
          { "west": "false", "down": "false" },
          { "west": "false", "north": "true" },
          { "west": "false", "south": "true" },
          { "west": "false", "east": "true" }
        ]
      },
      "apply": { "model": "minecraft:block/mushroom_block_inside", "y": 270, "uvlock": false }
    },
    {
      "when": { "up": "false" },
      "apply": { "model": "minecraft:block/mushroom_block_inside", "x": 270, "uvlock": false }
    },
    {
      "when": { "down": "false" },
      "apply": { "model": "minecraft:block/mushroom_block_inside", "x": 90, "uvlock": false }
    }
  ]
}
